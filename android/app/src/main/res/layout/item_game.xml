<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="wrap_content"
    android:layout_marginHorizontal="4dp" android:layout_marginVertical="5dp" app:cardCornerRadius="18dp"
    app:cardBackgroundColor="@color/ludex_surface" app:strokeWidth="1dp" app:strokeColor="@color/ludex_stroke">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal"
        android:gravity="center_vertical" android:padding="14dp">
        <FrameLayout android:layout_width="54dp" android:layout_height="72dp" android:layout_marginEnd="12dp">
            <TextView android:id="@+id/game_icon_placeholder" android:layout_width="match_parent"
                android:layout_height="match_parent" android:gravity="center"
                android:background="@color/ludex_stroke" android:textColor="@color/ludex_text"
                android:textStyle="bold" android:textSize="15sp" android:maxLines="1"/>
            <ImageView android:id="@+id/game_icon" android:layout_width="match_parent"
                android:layout_height="match_parent" android:scaleType="centerCrop"
                android:contentDescription="" android:visibility="gone"/>
        </FrameLayout>
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
            <TextView android:id="@+id/game_title" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:textColor="@color/ludex_text" android:textStyle="bold" android:textSize="16sp" android:maxLines="1"/>
            <TextView android:id="@+id/game_meta" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:textColor="@color/ludex_muted" android:textSize="12sp" android:layout_marginTop="3dp"/>
            <TextView android:id="@+id/game_date" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:textColor="@color/ludex_muted" android:textSize="11sp" android:layout_marginTop="2dp"
                android:visibility="gone"/>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="7dp">
                <TextView android:id="@+id/game_time" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:textColor="@color/ludex_accent" android:textStyle="bold" android:textSize="12sp"/>
                <TextView android:id="@+id/game_status" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginStart="10dp" android:textColor="@color/ludex_muted" android:textSize="12sp"/>
            </LinearLayout>
        </LinearLayout>
        <com.google.android.material.button.MaterialButton android:id="@+id/game_play"
            style="@style/Widget.Material3.Button.TonalButton" android:layout_width="wrap_content" android:layout_height="42dp"
            android:text="Jogar" android:layout_marginStart="8dp"/>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
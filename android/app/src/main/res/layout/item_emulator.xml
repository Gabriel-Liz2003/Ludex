<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
 xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="wrap_content"
 android:layout_margin="5dp" app:cardCornerRadius="18dp" app:cardBackgroundColor="@color/ludex_surface"
 app:strokeWidth="1dp" app:strokeColor="@color/ludex_stroke">
 <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
  <TextView android:id="@+id/emu_name" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/ludex_text" android:textStyle="bold" android:textSize="17sp"/>
  <TextView android:id="@+id/emu_pkg" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/ludex_muted" android:textSize="12sp" android:layout_marginTop="3dp"/>
  <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="10dp">
   <com.google.android.material.button.MaterialButton android:id="@+id/emu_open" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Abrir emulador"/>
   <com.google.android.material.button.MaterialButton android:id="@+id/emu_rom" style="@style/Widget.Material3.Button.OutlinedButton" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="8dp" android:text="Escolher ROM"/>
  </LinearLayout>
 </LinearLayout>
</com.google.android.material.card.MaterialCardView>
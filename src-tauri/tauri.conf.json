{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Ludex",
  "version": "0.1.0",
  "identifier": "com.ludex.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Ludex",
        "width": 1440,
        "height": 900,
        "minWidth": 900,
        "minHeight": 620
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": "all"
  }
}
